    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "mongodb-memory-server-core": "^10.4.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"

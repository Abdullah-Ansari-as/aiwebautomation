# Copy to .env.local for local development, or .env.production.local on the
# production server (chmod 600). Never commit real values.

# --- Database (required for inquiries and the admin Leads section) ----------
# MongoDB 6.0+ (Community Server 8.0 recommended). Use a dedicated app user
# with only the readWrite role on this database.
#
# Generate every password/secret in this file with:  openssl rand -hex 24
# Hex avoids `#` (starts a comment) and `$` (expanded by Next.js), which
# silently change values in .env files, and needs no URL-encoding.
MONGODB_URI=mongodb://webaiautomation_app:<password>@127.0.0.1:27017/webaiautomation?authSource=webaiautomation
MONGODB_DB_NAME=webaiautomation
# Optional: max pooled connections per server process (default 10).
# MONGODB_MAX_POOL_SIZE=10
# Optional, only for `npm run db:setup`: an admin/dbOwner URI so validators can
# be applied. Never store it here and never put it on a command line; provide
# it via a hidden prompt + preserved environment variable
# (docs/ORACLE-CLOUD-DEPLOYMENT.md, step 13.1).
# MONGODB_SETUP_URI=

# --- Admin authentication (required to open /admin) -------------------------
# Random secret, 32+ characters. Signs admin sessions and keys IP hashes.
# Generate with:  openssl rand -hex 24
AUTH_SECRET=
# Admin password, 12+ characters. Changing it signs out all admin sessions.
# Generate with:  openssl rand -hex 24
ADMIN_PASSWORD=

# --- Email notifications (optional, recommended) ----------------------------
# Resend API key (https://resend.com). Without it, inquiries are still saved
# and visible in /admin/leads, but no email is sent.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "WebAIAutomation <leads@webaiautomation.com>"
EMAIL_FROM=
# Where new-lead notifications go. Defaults to the site email in src/data/site.ts.
LEADS_NOTIFY_EMAIL=

# --- Public contact details (optional) --------------------------------------
# WhatsApp business number, international format, digits only (e.g. 15551234567).
# Read at build time; WhatsApp buttons stay hidden while empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Multiple app instances only ---------------------------------------------
# Keeps Server Action IDs decryptable across instances. Not needed on a single VPS.
#   openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

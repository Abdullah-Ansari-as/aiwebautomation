# Copy to .env.local for local development, or .env.production.local on the
# production server (chmod 600). Never commit real values.

# --- Database (required: forms, leads, clients, invoices, analytics) --------
# MongoDB 6.0+ (Community Server 8.0 recommended) or MongoDB Atlas. Use a
# dedicated app user with only the readWrite role on this database.
#
# Local development without installing MongoDB:  npm run db:local
#   MONGODB_URI=mongodb://127.0.0.1:27017/webaiautomation
# MongoDB Atlas (Database → Connect → Drivers), add the database name before "?":
#   MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/webaiautomation?retryWrites=true&w=majority
#   and allow your server's IP under Atlas → Network Access.
#
# Generate every password/secret in this file with:  openssl rand -hex 24
# Hex avoids `#` (starts a comment) and `$` (expanded by Next.js), which
# silently change values in .env files, and needs no URL-encoding.
MONGODB_URI=mongodb://webaiautomation_app:<password>@127.0.0.1:27017/webaiautomation?authSource=webaiautomation
MONGODB_DB_NAME=webaiautomation
# Optional: max pooled connections per server process (default 10).
# MONGODB_MAX_POOL_SIZE=10
# Optional, only for `npm run db:setup`: an admin/dbOwner URI so validators can
# be applied. Never store it here and never put it on a command line; provide
# it via a hidden prompt + preserved environment variable
# (docs/ORACLE-CLOUD-DEPLOYMENT.md, step 13.1).
# MONGODB_SETUP_URI=

# --- Admin authentication (required to open /admin) -------------------------
# The SUPER ADMIN signs in at /admin/login with ADMIN_EMAIL + ADMIN_PASSWORD.
# This login works even if the database is down. Team members (admin/viewer)
# are added later in /admin/team and stored in MongoDB.
# Random secret, 32+ characters. Signs admin sessions and keys IP hashes.
# Generate with:  openssl rand -hex 24
AUTH_SECRET=
# Super admin login email (defaults to the site email in src/data/site.ts).
ADMIN_EMAIL=
# Super admin password, 12+ characters. Changing it signs out all sessions.
# Generate with:  openssl rand -hex 24
ADMIN_PASSWORD=
# Optional display name for the super admin (default "Super admin").
ADMIN_NAME=

# Base URL used in emails and invoice links (default: the canonical domain in
# src/data/site.ts). Set http://localhost:3000 while testing locally.
APP_URL=

# --- Email notifications (optional, recommended) ----------------------------
# Resend API key (https://resend.com). Without it, leads, messages and
# submissions are still saved in the admin, but no email is sent, and invoices
# are shared by copying their link instead of emailing them.
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "WebAIAutomation <leads@webaiautomation.com>"
EMAIL_FROM=
# Where notifications (leads, messages, submissions) go. Defaults to the site email.
LEADS_NOTIFY_EMAIL=

# --- Public contact details (optional) --------------------------------------
# WhatsApp business number, international format, digits only (e.g. 15551234567).
# Read at build time; WhatsApp buttons stay hidden while empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Calendly / Cal.com link for a "Book a free call" button on /services (build time).
NEXT_PUBLIC_BOOKING_URL=

# --- Multiple app instances only ---------------------------------------------
# Keeps Server Action IDs decryptable across instances. Not needed on a single VPS.
#   openssl rand -base64 32
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
